# Midnight Blue — a cool, deep-navy Ghostty theme.
# Soft cool-white foreground on dark navy; saturated, blue/cyan-distinct palette.
#
# Install: copy this file to ~/.config/ghostty/themes/midnight-blue
#          then add `theme = midnight-blue` to ~/.config/ghostty/config

# --- Base colors ---
background = 1A1F2B
foreground = E6EAF2

# Selection: deep navy tint so highlighted text stays readable
selection-background = 33508A
selection-foreground = FFFFFF

# Cursor
cursor-color = 8FB6E8

# --- ANSI palette (0-7 normal, 8-15 bright) ---
palette = 0=#39414F
palette = 1=#FF6B6B
palette = 2=#8CE0A0
palette = 3=#FFD479
palette = 4=#6FA8FF
palette = 5=#C792EA
palette = 6=#56C9D6
palette = 7=#D8DEE9
palette = 8=#5A6478
palette = 9=#FF8B8B
palette = 10=#A6E8B4
palette = 11=#FFE3A3
palette = 12=#9CC4FF
palette = 13=#DDB0F6
palette = 14=#8BE9F0
palette = 15=#FFFFFF
